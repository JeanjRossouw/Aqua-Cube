{%- assign cart_count = cart.item_count -%}

{%- comment -%}
  Render-helper macros for the three dropdowns. Filter blocks by the
  per-block `parent` select to know which dropdown they belong to.
{%- endcomment -%}

<nav class="ac-nav" aria-label="Main navigation">
  <div class="ac-page ac-nav__row">

    {% render 'logo-stamp', href: routes.root_url, label: shop.name %}

    <ul class="ac-nav__links" id="NavMenu" role="menubar">
      {%- comment -%} Linklist-driven megamenu. Categories come from the `main-menu`
        linklist; brands from the `brands` linklist. No 30-block cap; survives GitHub sync. {%- endcomment -%}
      {%- for link in linklists['main-menu'].links -%}
        {%- if link.links.size > 0 -%}
          {%- assign is_mega = false -%}
          {%- for child in link.links -%}
            {%- if child.links.size > 0 -%}{%- assign is_mega = true -%}{%- endif -%}
          {%- endfor -%}
          <li class="ac-nav__drop" role="none">
            <button class="ac-nav__trigger" type="button" aria-haspopup="true" aria-expanded="false" role="menuitem">
              {{ link.title }}
              {% render 'icon-caret-down' %}
            </button>
            {%- if is_mega -%}
              <div class="ac-nav__menu ac-nav__menu--mega" role="menu">
                {%- for child in link.links -%}
                  <div class="ac-nav__col">
                    {%- if child.links.size > 0 -%}
                      <a class="ac-nav__col-title" href="{{ child.url }}" role="menuitem">{{ child.title }}</a>
                      {%- for gc in child.links -%}
                        <a class="ac-nav__item" href="{{ gc.url }}" role="menuitem"><span class="ac-nav__item-title">{{ gc.title }}</span></a>
                      {%- endfor -%}
                    {%- else -%}
                      <a class="ac-nav__item ac-nav__item--lone" href="{{ child.url }}" role="menuitem"><span class="ac-nav__item-title">{{ child.title }}</span></a>
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              </div>
            {%- else -%}
              <div class="ac-nav__menu ac-nav__menu--narrow" role="menu">
                {%- for child in link.links -%}
                  <a class="ac-nav__item" href="{{ child.url }}" role="menuitem"><span class="ac-nav__item-title">{{ child.title }}</span></a>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </li>
        {%- else -%}
          <li role="none">
            <a href="{{ link.url }}" class="ac-nav__link{% if link.current %} is-active{% endif %}" role="menuitem">{{ link.title }}</a>
          </li>
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} Shop by Brand — from the `brands` linklist {%- endcomment -%}
      {%- if linklists['brands'].links.size > 0 -%}
        <li class="ac-nav__drop ac-nav__drop--brands" role="none">
          <button class="ac-nav__trigger" type="button" aria-haspopup="true" aria-expanded="false" role="menuitem">
            Shop by Brand
            {% render 'icon-caret-down' %}
          </button>
          <div class="ac-nav__menu ac-nav__menu--brands" role="menu">
            {%- for brand in linklists['brands'].links -%}
              <a class="ac-nav__item" href="{{ brand.url }}" role="menuitem"><span class="ac-nav__item-title">{{ brand.title }}</span></a>
            {%- endfor -%}
          </div>
        </li>
      {%- endif -%}
    </ul>

    <div class="ac-nav__icons">
      {%- if section.settings.show_search -%}
        <a href="{{ routes.search_url }}" aria-label="Search">
          {% render 'icon-search' %}
        </a>
      {%- endif -%}
      {%- if section.settings.show_account -%}
        <a href="{{ routes.account_url }}" aria-label="Account">
          {% render 'icon-account' %}
        </a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="ac-nav__bag" aria-label="Cart ({{ cart_count }})">
        {% render 'icon-cart' %}
        {%- if cart_count > 0 -%}
          <span class="ac-nav__bag-dot" id="cart-count">{{ cart_count }}</span>
        {%- endif -%}
      </a>
    </div>

    <button class="ac-nav__burger" id="Hamburger" type="button"
            aria-label="Toggle menu" aria-controls="NavMenu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

{% schema %}
{
