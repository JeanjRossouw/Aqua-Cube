<section class="section ethos-band">
  <div class="wrap">
    <div class="prose">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="ethos-band__grid">
        {%- for block in section.blocks -%}
          <div class="ethos-band__item" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Ethos band",
  "blocks": [
    {
      "type": "item",
      "name": "Pillar",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "One of one" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Every piece is a single edition. Never restocked, never repeated." }
      ]
    }
  ],
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The promise" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why one of one matters" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A garment sewn once is a garment that belongs to a single child — the only one in the world." }
  ],
  "presets": [
    {
      "name": "Ethos band",
      "blocks": [
        { "type": "item", "settings": { "heading": "Hand-sewn", "text": "Cut, stitched and finished entirely by hand." } },
        { "type": "item", "settings": { "heading": "One of one", "text": "A single edition of each piece — never repeated." } },
        { "type": "item", "settings": { "heading": "Made to keep", "text": "Heirloom construction, made to be handed down." } }
      ]
    }
  ]
}
{% endschema %}
