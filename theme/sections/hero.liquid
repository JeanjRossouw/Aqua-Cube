<section class="hero">
  <div class="hero__inner">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h1 class="hero__title">{{ section.settings.heading }}</h1>{%- endif -%}
    {%- if section.settings.subheading != blank -%}<p class="hero__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="btn btn--solid" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Couture for 11½″ fashion dolls" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One thread, one gown, never repeated." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Each piece is hand-sewn as a single unit — a true one-of-one. Once it finds a home, it is gone for good." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View the collection" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
