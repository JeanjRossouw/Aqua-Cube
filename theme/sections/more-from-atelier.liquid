{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = product.collections.first
  endif
-%}
{%- if source != blank -%}
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      <div class="grid">
        {%- assign shown = 0 -%}
        {%- for p in source.products -%}
          {%- unless p.id == product.id -%}
            {%- if shown < section.settings.products_to_show -%}
              {% render 'product-card', product: p %}
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "More from the atelier",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "More from the atelier" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave blank to use the product's own collection." },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "label": "Pieces to show", "default": 3 }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "More from the atelier" }]
}
{% endschema %}
