<section class="section">
  <div class="wrap">
    <div class="prose">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="lead">{{ section.settings.text }}</div>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Atelier intro",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Atelier" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made by hand, made but once" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Maison Miette is a small couture house dressing fashion dolls in garments cut, sewn and finished entirely by hand. We do not run editions or restocks — every piece is conceived as a single edition, sewn once and never again.</p>" }
  ],
  "presets": [{ "name": "Atelier intro" }]
}
{% endschema %}
