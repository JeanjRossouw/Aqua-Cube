{%- comment -%}Breadcrumb navigation. Auto-detects template context.{%- endcomment -%}
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="{{ routes.root_url }}">Home</a></li>
    {%- if template contains 'product' -%}
      {%- if collection -%}
        <li><a href="{{ collection.url }}">{{ collection.title }}</a></li>
      {%- else -%}
        <li><a href="{{ routes.all_products_collection_url }}">Products</a></li>
      {%- endif -%}
      <li aria-current="page">{{ product.title }}</li>
    {%- elsif template contains 'collection' -%}
      <li><a href="{{ routes.collections_url }}">Collections</a></li>
      <li aria-current="page">{{ collection.title }}</li>
    {%- elsif template contains 'page' -%}
      <li aria-current="page">{{ page.title }}</li>
    {%- elsif template contains 'search' -%}
      <li aria-current="page">Search</li>
    {%- elsif template contains 'cart' -%}
      <li aria-current="page">Cart</li>
    {%- endif -%}
  </ol>
</nav>
