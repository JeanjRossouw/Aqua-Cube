{%- comment -%}
  Render a product card.
  Accepts: product (required), show_vendor (optional)
{%- endcomment -%}
<a href="{{ product.url }}" class="product-card">
  {%- if product.featured_image -%}
    <img src="{{ product.featured_image | image_url: width: 400 }}"
         alt="{{ product.featured_image.alt | default: product.title | escape }}"
         width="400" height="400" loading="lazy">
  {%- else -%}
    {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}
  {%- endif -%}
  <div class="product-card-body">
    {%- if show_vendor and product.vendor != blank -%}
      <small class="product-card__vendor">{{ product.vendor }}</small>
    {%- endif -%}
    <h3>{{ product.title }}</h3>
    <div class="price">
      {%- if product.compare_at_price > product.price -%}
        <span class="price__current">{{ product.price | money }}</span>
        <s class="price__compare">{{ product.compare_at_price | money }}</s>
      {%- else -%}
        {{ product.price | money }}
      {%- endif -%}
    </div>
    <span class="btn btn-primary">View</span>
  </div>
</a>
