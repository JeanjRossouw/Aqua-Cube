<nav class="navbar" aria-label="Main navigation">
  <div class="nav-container">
    <a href="{{ routes.root_url }}" class="logo">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 88 }}" alt="{{ shop.name }} Logo" class="logo-img" width="44" height="44">
      {%- else -%}
        <img src="{{ 'logo.svg' | asset_url }}" alt="{{ shop.name }} Logo" class="logo-img" width="44" height="44">
      {%- endif -%}
      <span>{{ section.settings.brand_name | default: shop.name | upcase }}</span>
    </a>

    <ul class="nav-menu" id="NavMenu">
      {%- for link in linklists[section.settings.menu].links -%}
        <li>
          <a href="{{ link.url }}"
             class="nav-link{% if link.active %} active{% endif %}"
             {% if link.active %}aria-current="page"{% endif %}>
            {{ link.title }}
          </a>
        </li>
      {%- endfor -%}
      <li>
        <form action="{{ routes.search_url }}" method="get" role="search" class="header-search">
          <label for="HeaderSearch" class="visually-hidden">{{ 'general.search.placeholder' | t }}</label>
          <input id="HeaderSearch" type="search" name="q" placeholder="{{ 'general.search.placeholder' | t }}" autocomplete="off">
          <button type="submit" aria-label="{{ 'general.search.submit' | t }}"><i class="fas fa-search"></i></button>
        </form>
      </li>
      <li>
        <a href="{{ routes.cart_url }}" class="nav-link cart-link" aria-label="Cart ({{ cart.item_count }})">
          <i class="fas fa-shopping-cart" aria-hidden="true"></i>&nbsp;<span id="cart-count">{{ cart.item_count }}</span>
        </a>
      </li>
    </ul>

    <button class="hamburger" id="Hamburger" aria-label="Toggle menu" aria-controls="NavMenu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name (shown next to logo)",
      "default": "AQUA CUBE"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "default": "main-menu"
    }
  ],
  "presets": [
    { "name": "Header" }
  ]
}
{% endschema %}
