{%- liquid
  case section.settings.primary_link_type
    when 'all_products'
      assign primary_url = routes.all_products_collection_url
    when 'collections_list'
      assign primary_url = routes.collections_url
    else
      assign primary_url = section.settings.primary_link
  endcase

  case section.settings.secondary_link_type
    when 'all_products'
      assign secondary_url = routes.all_products_collection_url
    when 'collections_list'
      assign secondary_url = routes.collections_url
    else
      assign secondary_url = section.settings.secondary_link
  endcase

  assign has_secondary_image = false
  if section.settings.image_secondary != blank or section.settings.image_secondary_placeholder_url != blank
    assign has_secondary_image = true
  endif
-%}

<section class="ac-hero" aria-labelledby="hero-heading-{{ section.id }}">
  <div class="ac-hero__bg" aria-hidden="true"></div>
  <div class="ac-hero__grid" aria-hidden="true"></div>

  <div class="ac-hero__inner">
    <div class="ac-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <span class="ac-eyebrow">
          <span class="ac-eyebrow__pulse" aria-hidden="true"></span>
          <span class="ac-mono">{{ section.settings.eyebrow }}</span>
        </span>
      {%- endif -%}

      <h1 id="hero-heading-{{ section.id }}">
        {%- if section.settings.heading_line_1 != blank -%}
          {{ section.settings.heading_line_1 }}
        {%- endif -%}
        {%- if section.settings.heading_line_2 != blank -%}
          {%- if section.settings.heading_line_1 != blank %}<br>{% endif -%}
          <em>{{ section.settings.heading_line_2 }}</em>
        {%- endif -%}
        {%- if section.settings.heading_line_3 != blank -%}
          {%- if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank %}<br>{% endif -%}
          {{ section.settings.heading_line_3 }}
        {%- endif -%}
      </h1>

      {%- if section.settings.lede != blank -%}
        <p class="ac-hero__lede">{{ section.settings.lede }}</p>
      {%- endif -%}

      <div class="ac-hero__cta">
        {%- if section.settings.primary_label != blank -%}
          <a class="ac-btn ac-btn--primary" href="{{ primary_url | default: routes.all_products_collection_url }}">
            {{ section.settings.primary_label }}
            {% render 'icon-arrow-right' %}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="ac-btn ac-btn--ghost" href="{{ secondary_url | default: '#' }}">
            {{ section.settings.secondary_label }}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="ac-stats">
        {%- for block in section.blocks -%}
          {%- if block.type == 'stat' -%}
            <div class="ac-stats__stat" {{ block.shopify_attributes }}>
              <div class="ac-stats__k">{{ block.settings.label | escape }}</div>
              <div class="ac-stats__v">
                {{ block.settings.value }}{% if block.settings.unit != blank %}<small>{{ block.settings.unit }}</small>{% endif %}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- comment -%}
    Photo container placed AFTER .ac-hero__inner so that on mobile (where it
    flips to position: relative) it stacks below the text. On desktop the
    photo is position: absolute so source order doesn't affect layout.
    When a secondary image is supplied it renders as a smaller foreground
    tile overlapping the back image on the right.
  {%- endcomment -%}
  <div class="ac-hero__photo{% if has_secondary_image %} ac-hero__photo--dual{% endif %}" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      <img class="ac-hero__photo-back"
           src="{{ section.settings.image | image_url: width: 1600 }}"
           srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 1600 }} 1600w"
           sizes="(max-width: 560px) 100vw, 58vw"
           alt="{{ section.settings.image.alt | escape }}"
           loading="eager" fetchpriority="high">
    {%- elsif section.settings.image_placeholder_url != blank -%}
      <img class="ac-hero__photo-back"
           src="{{ section.settings.image_placeholder_url }}"
           alt="Aquarium"
           loading="eager" fetchpriority="high">
    {%- else -%}
      <img class="ac-hero__photo-back"
           src="{{ 'hero-tank.png' | asset_url }}"
           alt="Lit reef aquarium"
           loading="eager" fetchpriority="high">
    {%- endif -%}

    {%- if has_secondary_image -%}
      {%- if section.settings.image_secondary != blank -%}
        <img class="ac-hero__photo-front"
             src="{{ section.settings.image_secondary | image_url: width: 800 }}"
             alt="{{ section.settings.image_secondary.alt | escape }}"
             loading="eager">
      {%- else -%}
        <img class="ac-hero__photo-front"
             src="{{ section.settings.image_secondary_placeholder_url }}"
             alt="Paludarium"
             loading="eager">
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text",     "id": "eyebrow",        "label": "Eyebrow text",                          "default": "Aquariums & Paludariums · South Africa" },
    { "type": "text",     "id": "heading_line_1", "label": "Heading — line 1 (white)",              "default": "Aquariums," },
    { "type": "text",     "id": "heading_line_2", "label": "Heading — line 2 (italic aqua accent)", "default": "paludariums," },
    { "type": "text",     "id": "heading_line_3", "label": "Heading — line 3 (white)",              "default": "everything in between." },
    { "type": "textarea", "id": "lede",           "label": "Lede paragraph",                        "default": "South Africa's destination for premium aquariums, complete paludarium setups, isopods, springtails, moss, plants, and every piece of equipment to bring them to life." },

    { "type": "header", "content": "Primary button" },
    { "type": "text", "id": "primary_label", "label": "Label", "default": "Shop aquariums" },
    {
      "type": "select",
      "id": "primary_link_type",
      "label": "Destination",
      "default": "custom",
      "options": [
        { "value": "all_products",     "label": "All products" },
        { "value": "collections_list", "label": "All collections" },
        { "value": "custom",           "label": "Custom URL (below)" }
      ]
    },
    { "type": "url", "id": "primary_link", "label": "Custom URL" },

    { "type": "header", "content": "Secondary button" },
    { "type": "text", "id": "secondary_label", "label": "Label", "default": "Shop paludariums" },
    {
      "type": "select",
      "id": "secondary_link_type",
      "label": "Destination",
      "default": "custom",
      "options": [
        { "value": "all_products",     "label": "All products" },
        { "value": "collections_list", "label": "All collections" },
        { "value": "custom",           "label": "Custom URL (below)" }
      ]
    },
    { "type": "url", "id": "secondary_link", "label": "Custom URL" },

    { "type": "header", "content": "Hero photos" },
    { "type": "image_picker", "id": "image",                     "label": "Primary image (back) — aquarium",
      "info": "Uploaded image wins. Falls back to the placeholder URL below, then to bundled assets/hero-tank.png." },
    { "type": "text",         "id": "image_placeholder_url",     "label": "Primary placeholder URL",
      "info": "Demo default is a free Unsplash photo." },
    { "type": "image_picker", "id": "image_secondary",           "label": "Secondary image (front) — paludarium",
      "info": "Optional. Renders as a smaller framed tile overlapping the primary image on the right." },
    { "type": "text",         "id": "image_secondary_placeholder_url", "label": "Secondary placeholder URL",
      "info": "Demo default is a free Unsplash terrarium/paludarium photo.",
      "default": "https://images.unsplash.com/photo-1578313097818-dfe8d38aa758?w=1200&q=80" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "label", "label": "Label",        "default": "Varieties" },
        { "type": "text", "id": "value", "label": "Value",        "default": "1,600+" },
        { "type": "text", "id": "unit",  "label": "Unit (small)", "default": "products" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "category": "Aqua Cube",
      "blocks": [
        { "type": "stat", "settings": { "label": "Varieties", "value": "1,600+",                "unit": "products" } },
        { "type": "stat", "settings": { "label": "Builds",    "value": "Aquariums + Paludariums" } },
        { "type": "stat", "settings": { "label": "Cultures",  "value": "Isopods + Springtails" } },
        { "type": "stat", "settings": { "label": "Shipping",  "value": "Across SA" } }
      ]
    }
  ]
}
{% endschema %}
