{%- liquid
  case section.settings.primary_link_type
    when 'all_products'
      assign primary_url = routes.all_products_collection_url
    when 'collections_list'
      assign primary_url = routes.collections_url
    else
      assign primary_url = section.settings.primary_link
  endcase

  case section.settings.secondary_link_type
    when 'all_products'
      assign secondary_url = routes.all_products_collection_url
    when 'collections_list'
      assign secondary_url = routes.collections_url
    else
      assign secondary_url = section.settings.secondary_link
  endcase
-%}

<section class="ac-hero" aria-labelledby="hero-heading-{{ section.id }}">
  <div class="ac-hero__bg" aria-hidden="true"></div>
  <div class="ac-hero__grid" aria-hidden="true"></div>

  <div class="ac-hero__inner">
    <div class="ac-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <span class="ac-eyebrow">
          <span class="ac-eyebrow__pulse" aria-hidden="true"></span>
          <span class="ac-mono">{{ section.settings.eyebrow }}</span>
        </span>
      {%- endif -%}

      <h1 id="hero-heading-{{ section.id }}">
        {%- if section.settings.heading_line_1 != blank -%}
          {{ section.settings.heading_line_1 }}
        {%- endif -%}
        {%- if section.settings.heading_line_1 != blank and section.settings.heading_line_2 != blank -%}
          <br>
        {%- endif -%}
        {%- if section.settings.heading_line_2 != blank -%}
          <em>{{ section.settings.heading_line_2 }}</em>
        {%- endif -%}
      </h1>

      {%- if section.settings.lede != blank -%}
        <p class="ac-hero__lede">{{ section.settings.lede }}</p>
      {%- endif -%}

      <div class="ac-hero__cta">
        {%- if section.settings.primary_label != blank -%}
          <a class="ac-btn ac-btn--primary" href="{{ primary_url | default: routes.all_products_collection_url }}">
            {{ section.settings.primary_label }}
            {% render 'icon-arrow-right' %}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="ac-btn ac-btn--ghost" href="{{ secondary_url | default: '#' }}">
            {{ section.settings.secondary_label }}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="ac-stats">
        {%- for block in section.blocks -%}
          {%- if block.type == 'stat' -%}
            <div class="ac-stats__stat" {{ block.shopify_attributes }}>
              <div class="ac-stats__k">{{ block.settings.label | escape }}</div>
              <div class="ac-stats__v">
                {{ block.settings.value }}{% if block.settings.unit != blank %}<small>{{ block.settings.unit }}</small>{% endif %}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- comment -%}
    Photo is placed AFTER .ac-hero__inner so that on mobile (where it
    becomes position: relative) it stacks below the text. On desktop the
    photo is position: absolute, so source order doesn't affect layout.
  {%- endcomment -%}
  <div class="ac-hero__photo" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1600 }}"
           srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 1600 }} 1600w"
           sizes="(max-width: 560px) 100vw, 58vw"
           alt="{{ section.settings.image.alt | escape }}"
           width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}"
           loading="eager" fetchpriority="high">
    {%- else -%}
      <img src="{{ 'hero-tank.png' | asset_url }}"
           alt="Lit reef aquarium"
           loading="eager" fetchpriority="high">
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text",     "id": "eyebrow",        "label": "Eyebrow text",     "default": "Aquariums & Reef · South Africa" },
    { "type": "text",     "id": "heading_line_1", "label": "Heading — line 1", "default": "Lighting" },
    { "type": "text",     "id": "heading_line_2", "label": "Heading — line 2 (italic aqua accent)", "default": "redefined." },
    { "type": "textarea", "id": "lede",           "label": "Lede paragraph",   "default": "Our lighting systems blend precision and innovation for unparalleled aquatic plant and coral vitality." },

    { "type": "header", "content": "Primary button" },
    { "type": "text", "id": "primary_label", "label": "Label", "default": "Shop now" },
    {
      "type": "select",
      "id": "primary_link_type",
      "label": "Destination",
      "default": "all_products",
      "options": [
        { "value": "all_products",     "label": "All products" },
        { "value": "collections_list", "label": "All collections" },
        { "value": "custom",           "label": "Custom URL (below)" }
      ]
    },
    { "type": "url", "id": "primary_link", "label": "Custom URL" },

    { "type": "header", "content": "Secondary button" },
    { "type": "text", "id": "secondary_label", "label": "Label", "default": "Why Aqua Cube" },
    {
      "type": "select",
      "id": "secondary_link_type",
      "label": "Destination",
      "default": "custom",
      "options": [
        { "value": "all_products",     "label": "All products" },
        { "value": "collections_list", "label": "All collections" },
        { "value": "custom",           "label": "Custom URL (below)" }
      ]
    },
    { "type": "url", "id": "secondary_link", "label": "Custom URL" },

    { "type": "header", "content": "Background photograph" },
    { "type": "image_picker", "id": "image", "label": "Hero image", "info": "Sits on the right side, fades into the navy via gradient." }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "label", "label": "Label",        "default": "PAR · at 30cm" },
        { "type": "text", "id": "value", "label": "Value",        "default": "420" },
        { "type": "text", "id": "unit",  "label": "Unit (small)", "default": "μmol" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "category": "Aqua Cube",
      "blocks": [
        { "type": "stat", "settings": { "label": "PAR · at 30cm", "value": "420",            "unit": "μmol" } },
        { "type": "stat", "settings": { "label": "Spectrum",      "value": "Full · 410–680", "unit": "nm" } },
        { "type": "stat", "settings": { "label": "Pump flow",     "value": "12,000",         "unit": "L/h" } },
        { "type": "stat", "settings": { "label": "Warranty",      "value": "2",              "unit": "years · SA-wide" } }
      ]
    }
  ]
}
{% endschema %}
