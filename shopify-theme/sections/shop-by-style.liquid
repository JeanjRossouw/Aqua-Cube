<section class="ac-section" aria-labelledby="sbs-heading-{{ section.id }}">
  <div class="ac-page">
    <div class="ac-section-head">
      <div class="ac-section-head__left">
        {%- if section.settings.eyebrow != blank -%}
          <span class="ac-mono">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 id="sbs-heading-{{ section.id }}">
          {%- if section.settings.heading_line_1 != blank -%}
            {{ section.settings.heading_line_1 }}
          {%- endif -%}
          {%- if section.settings.heading_line_1 != blank and section.settings.heading_line_2_accent != blank -%}
            <br>
          {%- endif -%}
          {%- if section.settings.heading_line_2_accent != blank -%}
            <em>{{ section.settings.heading_line_2_accent }}</em>
          {%- endif -%}
        </h2>
      </div>
      {%- if section.settings.description != blank -%}
        <p class="ac-section-head__right">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="sbs-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'style' -%}
            {%- liquid
              if block.settings.collection != blank
                assign card_url = block.settings.collection.url
              elsif block.settings.custom_url != blank
                assign card_url = block.settings.custom_url
              else
                assign card_url = '#'
              endif

              assign card_image = block.settings.image
              if card_image == blank and block.settings.collection != blank and block.settings.collection.image != blank
                assign card_image = block.settings.collection.image
              endif

              assign card_classes = 'sbs-card'
              if block.settings.flagship
                assign card_classes = 'sbs-card sbs-card--flagship'
              endif
            -%}
            <a href="{{ card_url }}" class="{{ card_classes }}" aria-label="{{ block.settings.title | escape }}" {{ block.shopify_attributes }}>
              {%- if card_image != blank -%}
                <img class="sbs-card__img"
                     src="{{ card_image | image_url: width: 800 }}"
                     srcset="{{ card_image | image_url: width: 400 }} 400w, {{ card_image | image_url: width: 800 }} 800w, {{ card_image | image_url: width: 1200 }} 1200w"
                     sizes="(max-width: 560px) 100vw, (max-width: 920px) 50vw, 25vw"
                     alt="{{ card_image.alt | default: block.settings.title | escape }}"
                     loading="lazy">
              {%- elsif block.settings.placeholder_url != blank -%}
                <img class="sbs-card__img"
                     src="{{ block.settings.placeholder_url }}"
                     alt="{{ block.settings.title | escape }}"
                     loading="lazy">
              {%- else -%}
                <div class="sbs-card__placeholder" aria-hidden="true"></div>
              {%- endif -%}
              <div class="sbs-card__scrim" aria-hidden="true"></div>
              {%- if block.settings.badge_text != blank -%}
                <span class="sbs-card__badge">{{ block.settings.badge_text }}</span>
              {%- endif -%}
              <div class="sbs-card__body">
                {%- if block.settings.title != blank -%}
                  <h3 class="sbs-card__title">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <p class="sbs-card__desc">{{ block.settings.description }}</p>
                {%- endif -%}
                {%- if block.settings.cta_label != blank -%}
                  <span class="sbs-card__go">{{ block.settings.cta_label }} →</span>
                {%- endif -%}
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop by Style",
  "settings": [
    { "type": "text",     "id": "eyebrow",                "label": "Eyebrow",                          "default": "/ shop by style" },
    { "type": "text",     "id": "heading_line_1",         "label": "Heading — line 1 (white)",         "default": "Find your" },
    { "type": "text",     "id": "heading_line_2_accent",  "label": "Heading — line 2 (italic aqua)",   "default": "perfect build." },
    { "type": "textarea", "id": "description",            "label": "Description (right column)",       "default": "Whether you're chasing a calm planted layout, a vibrant reef, or a lush land-and-water paludarium — start with the build that fits your space and goals." }
  ],
  "blocks": [
    {
      "type": "style",
      "name": "Style card",
      "limit": 8,
      "settings": [
        { "type": "text",         "id": "title",       "label": "Title",        "default": "Planted Aquariums" },
        { "type": "text",         "id": "description", "label": "Description",  "default": "Nature, Iwagumi, Dutch — calm green layouts" },
        { "type": "text",         "id": "cta_label",   "label": "CTA label",    "default": "Explore",
          "info": "The arrow → is appended automatically." },
        { "type": "text",         "id": "badge_text",  "label": "Badge text",
          "info": "Optional aqua pill in top-left. Use for FLAGSHIP, NEW, etc." },
        { "type": "checkbox",     "id": "flagship",    "label": "Flagship treatment",
          "info": "Adds a subtle aqua glow and stronger border to make the card stand out.",
          "default": false },
        { "type": "image_picker", "id": "image",       "label": "Background image (uploaded)",
          "info": "Optional. Picked image wins over the placeholder URL below." },
        { "type": "text",         "id": "placeholder_url", "label": "Placeholder image URL",
          "info": "External URL used when no image is uploaded. Demo defaults are free Unsplash photos — replace with your own product/build photo for production." },
        { "type": "collection",   "id": "collection",  "label": "Link to collection" },
        { "type": "url",          "id": "custom_url",  "label": "Custom URL",
          "info": "Used when no collection is picked." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Style",
      "category": "Aqua Cube",
      "blocks": [
        { "type": "style", "settings": { "title": "Aquariums",     "description": "Glass tanks for freshwater, planted and reef setups",   "cta_label": "Explore",                                                "custom_url": "/collections/aquariums",        "link_type": "custom", "placeholder_url": "https://images.unsplash.com/photo-1691387896833-dba10ea7d614?w=1200&q=80" } },
        { "type": "style", "settings": { "title": "Paludariums",   "description": "Land meets water — complete bioactive setups",          "cta_label": "Explore", "badge_text": "FLAGSHIP", "flagship": true, "custom_url": "/collections/paludariums",      "link_type": "custom", "placeholder_url": "https://images.unsplash.com/photo-1578313097818-dfe8d38aa758?w=1200&q=80" } },
        { "type": "style", "settings": { "title": "Cleanup Crew",  "description": "Isopods and springtails for bioactive builds",          "cta_label": "Explore",                                                "custom_url": "/collections/cleanup-crew-1",   "link_type": "custom", "placeholder_url": "https://images.unsplash.com/photo-1730530355813-fdfb30480141?w=1200&q=80" } },
        { "type": "style", "settings": { "title": "Plants & Moss", "description": "Live plants and moss varieties",                        "cta_label": "Explore",                                                "custom_url": "/collections/plants-1",         "link_type": "custom", "placeholder_url": "https://images.unsplash.com/photo-1691387824643-227cc84127cf?w=1200&q=80" } },
        { "type": "style", "settings": { "title": "Equipment",     "description": "Lighting, pumps, filters, CO₂, hardscape, substrate",   "cta_label": "Explore",                                                "custom_url": "/collections/equipment",        "link_type": "custom", "placeholder_url": "https://images.unsplash.com/photo-1644810734090-ca39bfafe516?w=1200&q=80" } }
      ]
    }
  ]
}
{% endschema %}
