<section class="categories">
  <div class="container">
    <div class="section-header">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
    <div class="categories-grid">
      {%- for block in section.blocks -%}
        {%- assign target = collections[block.settings.collection] -%}
        <a href="{{ target.url | default: '#' }}" class="category-card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 200 }}"
                 alt="{{ block.settings.label | escape }}"
                 width="80" height="80" loading="lazy">
          {%- else -%}
            {{ block.settings.icon_svg }}
          {%- endif -%}
          <h3>{{ block.settings.label | default: target.title }}</h3>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything you need, organised for easy browsing"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category card",
      "settings": [
        { "type": "text",         "id": "label",      "label": "Label" },
        { "type": "collection",   "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image",      "label": "Icon image (overrides SVG below)" },
        { "type": "html",         "id": "icon_svg",   "label": "Inline SVG icon" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Categories",
      "category": "Aqua Cube",
      "blocks": [
        { "type": "category", "settings": { "label": "Aquariums",  "collection": "tanks" } },
        { "type": "category", "settings": { "label": "Filters",    "collection": "filtration" } },
        { "type": "category", "settings": { "label": "Lighting",   "collection": "lighting" } },
        { "type": "category", "settings": { "label": "Decorations","collection": "decorations" } }
      ]
    }
  ]
}
{% endschema %}
